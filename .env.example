# copy เป็น .env (ถูก .gitignore ไว้แล้ว) แล้วเติมค่า อย่า commit  ทุกค่าด้านล่างต้องไม่ว่าง
# สร้างค่าสุ่มได้ด้วย (PowerShell):  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(24))

MFA_DB_PASSWORD=
KC_ADMIN_PASSWORD=

# รหัสผ่านของ user ทดลอง "demo" (ใช้ตอน login)
DEMO_USER_PASSWORD=
# client secret ของ web1-backend (เว็บ) และ mfa-admin (เครื่องมือผู้ดูแล) ใน realm brand-a
WEB1_CLIENT_SECRET=
MFA_ADMIN_SECRET=

# คีย์ AES-256 แบบ base64 (32 bytes) ที่ mfa-service ใช้เข้ารหัส secret ของ TOTP
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   openssl:    openssl rand -base64 32
MFA_ENCRYPTION_KEY=
